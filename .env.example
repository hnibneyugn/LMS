# Copy to .env.local and fill in. See SETUP.md for how to obtain each value.
# NEVER commit .env.local. Only NEXT_PUBLIC_* vars are exposed to the browser.

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SERVER-ONLY, bypasses RLS. Used by /api/sync. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (Vercel AI SDK) ------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Cloudflare R2 (S3-compatible) ------------------------------------------
# R2 dashboard -> Manage R2 API Tokens. Bucket must be private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=user-documents

# --- GitHub content sync webhook --------------------------------------------
# Shared secret configured on the GitHub repo webhook; used to verify HMAC signatures.
GITHUB_WEBHOOK_SECRET=

# --- Admin ------------------------------------------------------------------
# Email that is allowed to access /admin/invite.
ADMIN_EMAIL=
