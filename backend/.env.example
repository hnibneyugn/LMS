# --- Supabase ---
# JWT verification uses the project's JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json (ES256).
# No shared JWT secret is needed for verification.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# --- Admin ---
ADMIN_EMAIL=
# --- CORS: frontend origin(s), comma-separated ---
ALLOWED_ORIGINS=http://localhost:5173
