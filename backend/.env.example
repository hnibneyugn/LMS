# --- Supabase ---
# JWT verification uses the project's JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json (ES256).
# No shared JWT secret is needed for verification.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# --- Admin ---
ADMIN_EMAIL=
# --- CORS: frontend origin(s), comma-separated ---
ALLOWED_ORIGINS=http://localhost:5173
# --- Cloudflare R2 (S3-compatible object storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
